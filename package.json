{
  "name": "flowlist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "next build",
    "start": "bun scripts/dev.ts start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply flowlist-db --remote",
    "agent:conformance": "bun scripts/agentonboard-conformance.ts",
    "agent:merge-check": "bun .merge-harness/merge-harness.ts && bun .merge-harness/migration-check.ts && bun .merge-harness/authmd-check.ts",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "bun run cf:build && bun run cf:deploy",
    "cf:build": "node node_modules/@opennextjs/cloudflare/dist/cli/index.js build",
    "cf:deploy": "node node_modules/@opennextjs/cloudflare/dist/cli/index.js deploy",
    "cf:tail": "node node_modules/wrangler/wrangler-dist/cli.js tail"
  },
  "dependencies": {
    "@agentonboard/sdk": "^0.3.0",
    "@clerk/nextjs": "^7.9.10",
    "@clerk/themes": "^2.4.57",
    "@radix-ui/react-checkbox": "^1.3.11",
    "clsx": "^2.1.1",
    "effect": "^4.0.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.148.0"
  },
  "patchedDependencies": {
    "@opennextjs/cloudflare@1.20.9": "patches/@opennextjs%2Fcloudflare@1.20.9.patch"
  }
}
